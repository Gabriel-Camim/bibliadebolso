# Modelo público. Preencha os valores reais somente no .env, ao lado de app.py.
# Endereço usado nos retornos do Google, do Facebook e da Stripe no computador.
PUBLIC_BASE_URL=http://127.0.0.1:5050
# No computador, sqlite mantém o banco existente. A Render gratuita usa turso.
DATABASE_BACKEND=sqlite
# Banco privado do projeto no plano Free do Turso (URL e token de leitura e escrita).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Opcional e apenas local. Token da conta Render para publicar pela API.
RENDER_API_KEY=
# Segredo aleatório do Flask. Localmente, a aplicação também gera uma chave própria.
SECRET_KEY=
# Chave de API do projeto da OpenAI, usada pelo chat bíblico.
OPENAI_API_KEY=
# Identificador e segredo do cliente OAuth do tipo Aplicativo da Web, no Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Meta for Developers > aplicativo com Facebook Login > configurações básicas.
# O retorno autorizado é PUBLIC_BASE_URL seguido de /auth/facebook/callback.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Opcional. O código possui uma versão padrão da API Graph.
FACEBOOK_GRAPH_VERSION=v27.0
# Após o cadastro, copie de Minha conta > Dados de identificação > Identificador da sua conta Google.
OWNER_GOOGLE_SUB=
# Chave de servidor da sandbox Stripe. Para teste, começa com sk_test_ ou rk_test_.
STRIPE_SECRET_KEY=
# Segredo de assinatura do destino de webhook. No teste local, use o whsec_ do stripe listen.
STRIPE_WEBHOOK_SECRET=
# Na sandbox, o ID bpc_ da configuração do Portal do Cliente criada para o site.
# Se vazio, a Stripe abre a configuração padrão da conta.
STRIPE_TEST_PORTAL_CONFIGURATION=
# Nome da pessoa ou razão social responsável pelo tratamento de dados do site. É público.
CONTROLLER_NAME=
# E-mail de atendimento de privacidade ou endereço HTTPS do canal. É público.
PRIVACY_CONTACT=
